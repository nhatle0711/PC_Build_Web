{
  "name": "pc-part-builder-checker",
  "version": "1.0.0",
  "description": "PC Part Builder & Hardware Compatibility Checker with Node.js, Express, and PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles --runInBand",
    "test:unit": "jest tests/unit --verbose",
    "test:integration": "jest tests/integration --verbose --runInBand",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"**/*.{js,json,md,html,css}\""
  },
  "keywords": [
    "pc-builder",
    "hardware-compatibility",
    "nodejs",
    "express",
    "postgresql",
    "redis",
    "psu-calculator"
  ],
  "author": "Full-Stack Engineer",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
